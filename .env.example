# 개발 서버 포트
# 고정하지 않으면 3000이 점유됐을 때 Next가 임의의 포트로 옮겨가고,
# 그러면 redirect_uri가 달라져 카카오 콘솔 등록값과 어긋난다(KOE006)
PORT=3100

# 콜백 URL의 오리진을 고정
# 미설정 시 요청 오리진을 쓰지만, 프록시 뒤에서는 실제 주소와 달라질 수 있어 명시한다
# 배포 환경 값은 .env.production 참고
APP_ORIGIN=http://localhost:3100

# 카카오 개발자 콘솔 > 앱 설정 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 카카오 개발자 콘솔 > 카카오 로그인 > 보안 > Client Secret (ON일 때만 필요)
KAKAO_CLIENT_SECRET=

# 네이버 개발자센터 > 애플리케이션 > 내 애플리케이션
# 네이버는 client_secret이 필수다 (카카오는 선택)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
