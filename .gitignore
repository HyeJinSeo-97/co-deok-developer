# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# OS
Thumbs.db

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# 시크릿이 담기는 개인/로컬 파일은 커밋하지 않는다
.env*
# 단, 시크릿이 없는 템플릿과 배포 공통 설정은 커밋한다
!.env.example
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
